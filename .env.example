# Copy to .env.local for local dev. On Vercel, set these under
# Project Settings -> Environment Variables instead (see README.md).
#
# Same Supabase project as the Akọ app — this site is a second
# frontend over the same backend, not a separate database.

# Supabase project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to expose client-side: access is
# actually enforced by Postgres RLS policies and by the
# admin_roles check in RequireAdmin, not by keeping this secret.
VITE_SUPABASE_ANON_KEY=

# Canonical site origin, used for SEO tags (canonical URLs, OG,
# sitemap) and for building the Paystack callback_url. Set to the
# real production domain once it's live.
VITE_SITE_URL=https://ako.app

# Public app-store / play-store links for the download page + CTAs.
# Leave blank to hide a badge until that store listing is live.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# --------------------------------------------------------------
# NOT set here on purpose:
#
#   PAYSTACK_SECRET_KEY / PAYSTACK_PUBLIC_KEY
#
# Paystack keys never touch this frontend. initiate-deposit and
# verify-deposit are Supabase Edge Functions that already hold
# PAYSTACK_SECRET_KEY as a Supabase secret (Project Settings ->
# Edge Functions -> Secrets on the Supabase dashboard, or
# `supabase secrets set PAYSTACK_SECRET_KEY=...`). This site just
# calls those functions with the user's Supabase session — same
# as the mobile app does. See README.md "Environment variables".
# --------------------------------------------------------------
